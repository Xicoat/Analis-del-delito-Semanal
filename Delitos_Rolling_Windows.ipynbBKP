      "2026-09-22 16:22:46,640 - [extract_crime_data] - INFO - Buscando ROBO A TRANSEUNTE SALIENDO DEL CAJERO CON VIOLENCIA\n",
      "2026-09-22 16:22:46,641 - [extract_crime_data] - INFO - Extrayendo registros\n",
      "2026-09-22 16:22:54,721 - [extract_crime_data] - INFO - Generando dataframe\n",
      "2026-09-22 16:22:54,724 - [extract_crime_data] - INFO - EXITO. Se extrajeron 641 registros.\n"
     ]
    }
   ],
   "source": [
    "# [EJECUCIÓN] Extracción de datos iniciales\n",
    "# INPUT:  DATA_PATH (Path), TARGET_CRIME (str)\n",
    "# OUTPUT: df_raw (pd.DataFrame)\n",
    "\n",
    "try:\n",
    "    df_raw = extract_crime_data(DATA_PATH, TARGET_CRIME)\n",
    "except FileNotFoundError as err:\n",
    "    logger.error(f\"Error de ejecución: {err}\")"
   ]
