    "# [EJECUCIÓN] Cómputo de métricas por nodo\n",
    "# INPUT:  visibility_graph (nx.Graph)\n",
    "# OUTPUT: df_node_metrics (pd.DataFrame)\n",
    "\n",
    "try:\n",
    "    df_node_metrics = compute_node_metrics(visibility_graph)\n",
