   ],
   "source": [
    "import networkx as nx\n",
    "import plotly.graph_objects as go\n",
    "\n",
    "def plot_visibility_graph_from_network(G: nx.Graph, crime_name: str = \"\") -> go.Figure:\n",
    "    \"\"\"Renderiza la serie temporal, líneas de visibilidad y nodos numerados únicamente usando el grafo G.\"\"\"\n",
    "    if G.number_of_nodes() == 0:\n",
    "        return go.Figure()\n",
    "\n",
    "    # 1. Extraer coordenadas directamente desde los atributos de los nodos de G\n",
    "    nodes = sorted(G.nodes())\n",
    "    x_bars = [G.nodes[i]['fecha_hecho'] for i in nodes]\n",
    "    y_bars = [G.nodes[i]['cantidad'] for i in nodes]\n",
    "\n",
    "    max_val = max(y_bars) if y_bars else 0\n",
    "    offset = max_val * 0.05 if max_val > 0 else 1\n",
    "\n",
    "    # 2. Construir los segmentos de las aristas de visibilidad (ancladas a la cúspide)\n",
    "    edge_x = []\n",
    "    edge_y = []\n",
    "    for u, v in G.edges():\n",
    "        edge_x.extend([G.nodes[u]['fecha_hecho'], G.nodes[v]['fecha_hecho'], None])\n",
    "        edge_y.extend([G.nodes[u]['cantidad'], G.nodes[v]['cantidad'], None])\n",
    "\n",
    "    fig = go.Figure()\n",
    "\n",
    "    # Traza 1: Barras de la serie temporal\n",
    "    fig.add_trace(go.Bar(\n",
    "        x=x_bars,\n",
    "        y=y_bars,\n",
    "        marker=dict(color='white', line=dict(color='black', width=1)),\n",
    "        name='Serie Temporal'\n",
    "    ))\n",
    "\n",
    "    # Traza 2: Líneas de visibilidad (aristas de la red uniendo cúspides)\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=edge_x,\n",
    "        y=edge_y,\n",
    "        mode='lines',\n",
    "        line=dict(color='red', width=0.8),\n",
    "        hoverinfo='none',\n",
    "        name='Visibilidad'\n",
    "    ))\n",
    "\n",
    "    # Traza 3: Marcadores en la cúspide de las barras (anclaje exacto)\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=x_bars,\n",
    "        y=y_bars,\n",
    "        mode='markers',\n",
    "        marker=dict(size=4, color='black'),\n",
    "        hoverinfo='skip',\n",
    "        name='Cúspides'\n",
    "    ))\n",
    "\n",
    "    # Traza 4: Nodos numerados sobre las barras con offset\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=x_bars,\n",
    "        y=[y + offset for y in y_bars],\n",
    "        mode='markers+text',\n",
    "        marker=dict(symbol='circle', color='white', size=14, line=dict(color='black', width=1)),\n",
    "        text=[str(i) for i in nodes],\n",
    "        textfont=dict(color='black', size=8),\n",
    "        textposition='middle center',\n",
    "        name='Nodos'\n",
    "    ))\n",
    "\n",
    "    # Configuración de layout\n",
    "    title_text = \"Red de Visibilidad Natural (NVG)\"\n",
    "    if crime_name:\n",
    "        title_text += f\"<br><b>{crime_name.title()}</b>\"\n",
    "\n",
    "    visible_ticks = x_bars[::16]\n",
    "\n",
    "    fig.update_layout(\n",
    "        title=dict(text=title_text, x=0.5, xanchor='center', font=dict(size=16, color='black')),\n",
    "        width=1300,\n",
    "        height=750,\n",
    "        plot_bgcolor='white',\n",
    "        paper_bgcolor='white',\n",
    "        bargap=0.1,\n",
    "        margin=dict(l=70, r=50, t=110, b=100),\n",
    "        showlegend=False,\n",
    "        xaxis=dict(\n",
    "            title='Inicio de Semana (Bloques de 168h)',\n",
    "            color='black',\n",
    "            showline=True,\n",
    "            linecolor='black',\n",
    "            linewidth=1.5,\n",
    "            tickangle=45,\n",
    "            tickmode='array',\n",
    "            tickvals=visible_ticks,\n",
    "            tickformat='%Y-%m-%d'\n",
    "        ),\n",
    "        yaxis=dict(\n",
    "            title='Cantidad de delitos',\n",
    "            color='black',\n",
    "            showline=True,\n",
    "            linecolor='black',\n",
    "            linewidth=1.5,\n",
    "            showgrid=True,\n",
    "            gridcolor='lightgrey',\n",
    "            gridwidth=0.2,\n",
    "            griddash='dash',\n",
    "            range=[0, max_val + (offset * 3)]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    fig.show()\n",
    "    #return fig\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "plot_visibility_graph_from_network(visibility_graph, target_crime)"
   ]
  },
