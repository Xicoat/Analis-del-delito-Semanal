      "\n",
      "======================================================================\n",
      "VALORES ESTRUCTURALES Y PARÁMETROS SEMANALES: ROBO A TRANSEUNTE SALIENDO DEL CAJERO CON VIOLENCIA\n",
      "======================================================================\n",
      "Estrategia       : Ataque Dirigido (Grado Alto)\n",
      "Modelo Cercano   : Random Regular (k=2)\n",
      "Distancia (D)    : 1.1226\n",
      "Parámetros extra : k = 2 | p = N/A\n",
      "----------------------------------------------------------------------\n",
      "Estrategia       : Falla Aleatoria\n",
      "Modelo Cercano   : Grid 2D\n",
      "Distancia (D)    : 1.7531\n",
      "Parámetros extra : k = N/A | p = N/A\n",
      "----------------------------------------------------------------------\n"
     ]
