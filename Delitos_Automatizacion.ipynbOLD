   "source": [
    "import warnings\n",
    "from scipy.optimize import OptimizeWarning\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import powerlaw\n",
    "\n",
    "# Suprimir advertencias internas de optimización de scipy/powerlaw\n",
    "warnings.simplefilter(\"ignore\", OptimizeWarning)\n",
    "\n",
    "def graficar_analisis_csn(grafo: nx.Graph, crime_name: str):\n",
    "    \"\"\"Calcula y grafica el análisis de Ley de Potencia bajo metodología CSN (2009).\"\"\"\n",
    "    if getattr(grafo, 'number_of_nodes', lambda: 0)() == 0:\n",
    "        print(\"❌ Error: El grafo está vacío.\")\n",
    "        return\n",
    "\n",
    "    # 1. Preparación de datos (filtrar grados = 0)\n",
    "    data = np.array([d for _, d in grafo.degree() if d > 0])\n",
    "    if len(data) == 0:\n",
    "        print(\"⚠️ El grafo no tiene nodos con grado mayor a cero.\")\n",
    "        return\n",
    "\n",
    "    print(\"Calculando análisis de Ley de Potencia (CSN)...\")\n",
    "\n",
    "    # 2. Ajuste Matemático y Comparación\n",
    "    fit = powerlaw.Fit(data, discrete=True, verbose=False)\n",
    "    ks_distancia = fit.power_law.D\n",
    "    R_log, p_comp = fit.distribution_compare('power_law', 'lognormal', normalized_ratio=True)\n",
    "\n",
    "    if p_comp < 0.05:\n",
    "        res_log = \"Power Law\" if R_log > 0 else \"Lognormal\"\n",
    "    else:\n",
    "        res_log = \"Inconclusivo (Ambas)\"\n",
    "\n",
    "    gamma_val = fit.power_law.alpha\n",
    "    sigma_val = fit.power_law.sigma\n",
    "    xmin_val = fit.power_law.xmin\n",
    "    nodos_cumplen = np.sum(data >= xmin_val)\n",
    "    total_nodos = len(data)\n",
    "\n",
    "    # 3. Extracción de fechas y Título\n",
    "    fechas = [pd.to_datetime(d['fecha_hecho']) for _, d in grafo.nodes(data=True) if 'fecha_hecho' in d]\n",
    "    rango_fechas = f\"({min(fechas).strftime('%Y-%m-%d')} – {max(fechas).strftime('%Y-%m-%d')})\" if fechas else \"(Periodo Desconocido)\"\n",
    "\n",
    "    titulo_grafico = (\n",
    "        f\"Distribución de Grado P(k) y Ajuste de Ley de Potencia (CSN)\\n\"\n",
    "        f\"Red de Visibilidad Semanal - {crime_name.title()}\\n\"\n",
    "        f\"{rango_fechas}\"\n",
    "    )\n",
    "\n",
    "    # 4. Renderizado del Gráfico\n",
    "    plt.figure(figsize=(7, 5), dpi=100)\n",
    "\n",
    "    fit.plot_pdf(color='black', marker='o', linestyle='None', markersize=5, label='Datos Empíricos')\n",
    "    fit.power_law.plot_pdf(color='red', linestyle='--', linewidth=2, label='Ajuste Óptimo Power Law')\n",
    "\n",
    "    # 5. Cuadro de Anotaciones Estadísticas\n",
    "    texto_stats = (\n",
    "        r\"$\\mathbf{Métricas\\ del\\ Ajuste:}$\" + \"\\n\"\n",
    "        f\"Exponente Gamma ($\\\\gamma$): {gamma_val:.4f} $\\\\pm$ {sigma_val:.4f}\\n\"\n",
    "        f\"Corte Inferior ($X_{{min}}$): {xmin_val:.2f}\\n\"\n",
    "        f\"Nodos ($k \\\\geq X_{{min}}$): {int(nodos_cumplen)} / {total_nodos} ({nodos_cumplen/total_nodos*100:.1f}%)\\n\\n\"\n",
    "        r\"$\\mathbf{Validación\\ Absoluta:}$\" + \"\\n\"\n",
    "        f\"Distancia KS (D): {ks_distancia:.4f}\\n\\n\"\n",
    "        r\"$\\mathbf{Comparación\\ Relativa:}$\" + \"\\n\"\n",
    "        f\"R (Log-Likelihood): {R_log:.4f}\\n\"\n",
    "        f\"p-value (Comp): {p_comp:.4f}\\n\"\n",
    "        f\"Ganador: {res_log}\"\n",
    "    )\n",
    "\n",
    "    plt.text(0.05, 0.05, texto_stats, transform=plt.gca().transAxes, fontsize=8,\n",
    "             verticalalignment='bottom', bbox=dict(boxstyle='round', facecolor='white', alpha=0.9))\n",
    "\n",
    "    # Formateo\n",
    "    plt.title(titulo_grafico, fontsize=11, pad=15)\n",
    "    plt.xlabel('Grado (k)', fontsize=10)\n",
    "    plt.ylabel('P(k)', fontsize=10)\n",
    "    plt.xscale('log')\n",
    "    plt.yscale('log')\n",
    "    plt.grid(True, which=\"both\", ls=\"--\", alpha=0.3)\n",
    "    plt.legend(loc='upper right', fontsize=8)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    #plt.show()\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "graficar_analisis_csn(visibility_graph, target_crime)"
   ]
  },
