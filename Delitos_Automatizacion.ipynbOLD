    "import numpy as np\n",
    "import pandas as pd\n",
    "import networkx as nx\n",
    "import random\n",
    "\n",
    "def calcular_distancias_resiliencia(grafo: nx.Graph) -> pd.DataFrame:\n",
    "    \"\"\"Calcula la distancia euclidiana normalizada entre las curvas de resiliencia (Aleatoria vs Dirigida).\"\"\"\n",
    "    if getattr(grafo, 'number_of_nodes', lambda: 0)() == 0:\n",
    "        print(\"❌ Error: El grafo está vacío.\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    # 1. PARÁMETROS BASE\n",
    "    N = grafo.number_of_nodes()\n",
    "    M = grafo.number_of_edges()\n",
    "    p = (2 * M) / (N * (N - 1)) if N > 1 else 0\n",
    "    sqrt_nodes = int(np.sqrt(N))\n",
    "\n",
    "    def enlace_igualitario(n, k):\n",
    "        G = nx.Graph()\n",
    "        G.add_nodes_from(range(n))\n",
    "        for i in range(n):\n",
    "            for j in range(i + 1, min(i + k + 1, n)):\n",
    "                G.add_edge(i, j)\n",
    "        return G\n",
    "\n",
    "    # 2. CONSTRUCCIÓN DE MODELOS TEÓRICOS EN MEMORIA\n",
    "    modelos = {\n",
    "        'Red Empírica Semanal': grafo,\n",
    "        f'Erdos Renyi (p={p:.4f})': nx.erdos_renyi_graph(N, p),\n",
    "        'Barabasi Albert (m=2)': nx.barabasi_albert_graph(N, 2) if N > 2 else None,\n",
    "        'Barabasi Albert (m=3)': nx.barabasi_albert_graph(N, 3) if N > 3 else None,\n",
    "        'Barabasi Albert (m=4)': nx.barabasi_albert_graph(N, 4) if N > 4 else None,\n",
    "        f'Watts Strogatz (p={p:.4f})': nx.watts_strogatz_graph(N, 4, p) if N >= 4 else None,\n",
    "        'Random Regular (k=2)': nx.random_regular_graph(2, N) if N > 2 else None,\n",
    "        'Enlace Igualitario 2': enlace_igualitario(N, 2),\n",
    "        'Enlace Igualitario 1': enlace_igualitario(N, 1),\n",
    "        'Star': nx.star_graph(N - 1) if N > 0 else None,\n",
    "        'Grid 2D': nx.grid_2d_graph(sqrt_nodes, sqrt_nodes) if sqrt_nodes > 0 else None,\n",
    "        'Ladder': nx.ladder_graph(N // 2) if N >= 2 else None,\n",
    "        'Hypercube': nx.hypercube_graph(int(np.log2(N))) if (N > 0 and (N & (N - 1)) == 0) else None,\n",
    "        'Complete': nx.complete_graph(N),\n",
    "        'Path': nx.path_graph(N),\n",
    "        'Cycle': nx.cycle_graph(N),\n",
    "        'Circular Ladder': nx.circular_ladder_graph(N // 2) if N >= 2 else None,\n",
    "    }\n",
    "    \n",
    "    modelos_validos = {k: v for k, v in modelos.items() if v is not None}\n",
    "\n",
    "    # 3. MOTORES DE SIMULACIÓN Y CÁLCULO DE DISTANCIA\n",
    "    def simular_remocion(G_teorico, nodos_ordenados):\n",
    "        G_copy = G_teorico.copy()\n",
    "        valores = []\n",
    "        for nodo in nodos_ordenados:\n",
    "            if nodo in G_copy:\n",
    "                G_copy.remove_node(nodo)\n",
    "            valores.append(nx.number_connected_components(G_copy))\n",
    "        return np.array(valores)\n",
    "\n",
    "    def distancia_normalizada(y1, y2):\n",
    "        min_len = min(len(y1), len(y2))\n",
    "        if min_len == 0: return np.nan\n",
    "        y1, y2 = y1[:min_len], y2[:min_len]\n",
    "        \n",
    "        max_y1, max_y2 = max(y1) if len(y1) > 0 else 0, max(y2) if len(y2) > 0 else 0\n",
    "        y1_norm = y1 / max_y1 if max_y1 > 0 else y1\n",
    "        y2_norm = y2 / max_y2 if max_y2 > 0 else y2\n",
    "        \n",
    "        return np.sqrt(np.sum((y1_norm - y2_norm) ** 2))\n",
    "\n",
    "    # 4. PROCESAMIENTO\n",
    "    resultados = []\n",
    "    for nombre_red, G_teorico in modelos_validos.items():\n",
    "        # Uso de random.sample para blindar el código ante tuplas (Grid 2D)\n",
    "        nodos_dirigidos = sorted(G_teorico.nodes(), key=lambda x: G_teorico.degree(x), reverse=True)\n",
    "        nodos_aleatorios = random.sample(list(G_teorico.nodes()), G_teorico.number_of_nodes())\n",
    "\n",
    "        curva_dirigida = simular_remocion(G_teorico, nodos_dirigidos)\n",
    "        curva_aleatoria = simular_remocion(G_teorico, nodos_aleatorios)\n",
    "\n",
    "        # La distancia compara la vulnerabilidad al azar vs el ataque inteligente\n",
    "        distancia = distancia_normalizada(curva_aleatoria, curva_dirigida)\n",
    "\n",
    "        resultados.append({\n",
    "            'Red Analizada': nombre_red,\n",
    "            'Diferencia (Aleatorio vs Dirigido)': round(distancia, 4) if not np.isnan(distancia) else np.nan\n",
    "        })\n",
    "\n",
    "    # 5. SALIDA DE DATOS\n",
    "    df_distancias = pd.DataFrame(resultados).sort_values(by='Diferencia (Aleatorio vs Dirigido)', ascending=False).reset_index(drop=True)\n",
    "\n",
    "    print(\"======================================================\")\n",
    "    print(\"   DISTANCIA DE RESILIENCIA (ALEATORIA VS DIRIGIDA)   \")\n",
    "    print(\"======================================================\")\n",
    "    display(df_distancias)\n",
    "\n",
    "    return df_distancias\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "df_distancias_resiliencia = calcular_distancias_resiliencia(visibility_graph)"
   ]
  },
