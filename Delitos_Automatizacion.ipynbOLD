   "source": [
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import sys\n",
    "import logging\n",
    "from logging.handlers import RotatingFileHandler\n",
    "\n",
    "# 1. Declaración del Logger a nivel de módulo\n",
    "logger = logging.getLogger(__name__)\n",
    "\n",
    "def setup_logging(log_file: str = \"app.log\"):\n",
    "    \"\"\"Configura los manejadores de consola y archivo para los logs.\"\"\"\n",
    "    logger.setLevel(logging.INFO)\n",
    "    formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n",
    "\n",
    "    # Manejador de consola\n",
    "    console_handler = logging.StreamHandler(sys.stdout)\n",
    "    console_handler.setFormatter(formatter)\n",
    "    \n",
    "    # Manejador de archivo rotativo (máximo 5MB, mantiene 3 respaldos)\n",
    "    file_handler = RotatingFileHandler(log_file, maxBytes=5*1024*1024, backupCount=3)\n",
    "    file_handler.setFormatter(formatter)\n",
    "\n",
    "    # Evitar duplicidad de manejadores si se ejecuta varias veces (ej. Jupyter)\n",
    "    if not logger.handlers:\n",
    "        logger.addHandler(console_handler)\n",
    "        logger.addHandler(file_handler)\n",
    "\n",
    "# Constants\n",
    "CRIME_CATEGORIES = [\n",
    "    'CONTAMINACIÓN O RESIDUOS', 'DELITOS AMBIENTALES', 'DELITOS CONTRA LA SALUD',\n",
    "    'DESAPARICION FORZADA DE PERSONAS', 'FEMINICIDIO', 'HOMICIDIO CULPOSO POR ARMA DE FUEGO',\n",
    "    'HOMICIDIO CULPOSO POR INSTRUMENTO PUNZO CORTANTE', 'HOMICIDIO POR ARMA BLANCA',\n",
    "    'HOMICIDIO POR ARMA DE FUEGO', 'HOMICIDIO POR GOLPES', 'NARCOMENUDEO POSESION SIMPLE',\n",
    "    'NARCOMENUDEO POSESIÓN CON FINES DE VENTA,COMERCIO Y SUMINISTRO', 'PLAGIO O SECUESTRO',\n",
    "    'PORTACION DE ARMA DE FUEGO', 'PRIV. ILEGAL DE LA LIB. Y ROBO DE VEHICULO',\n",
    "    'ROBO A CASA HABITACION CON VIOLENCIA', 'ROBO A CASA HABITACION SIN VIOLENCIA',\n",
    "    'ROBO A CASA HABITACION Y VEHICULO CON VIOLENCIA', 'ROBO A CASA HABITACION Y VEHICULO SIN VIOLENCIA',\n",
    "    'ROBO A NEGOCIO CON VIOLENCIA', 'ROBO A NEGOCIO SIN VIOLENCIA',\n",
    "    'ROBO A NEGOCIO Y VEHICULO CON VIOLENCIA', 'ROBO A NEGOCIO Y VEHICULO SIN VIOLENCIA',\n",
    "    'ROBO A PASAJERO / CONDUCTOR DE VEHICULO CON VIOLENCIA', 'ROBO A PASAJERO A BORDO DE METROBUS CON VIOLENCIA',\n",
    "    'ROBO A PASAJERO A BORDO DE METROBUS SIN VIOLENCIA', 'ROBO A REPARTIDOR CON VIOLENCIA',\n",
    "    'ROBO A REPARTIDOR SIN VIOLENCIA', 'ROBO A REPARTIDOR Y VEHICULO CON VIOLENCIA',\n",
    "    'ROBO A REPARTIDOR Y VEHICULO SIN VIOLENCIA', 'ROBO A SUCURSAL BANCARIA (ASALTO BANCARIO) CON VIOLENCIA',\n",
    "    'ROBO A SUCURSAL BANCARIA (SUPERMERCADO) CON VIOLENCIA', 'ROBO A SUCURSAL BANCARIA (SUPERMERCADO) SIN VIOLENCIA',\n",
    "    'ROBO A TRANSEUNTE DE CELULAR CON VIOLENCIA', 'ROBO A TRANSEUNTE DE CELULAR SIN VIOLENCIA',\n",
    "    'ROBO A TRANSEUNTE EN NEGOCIO CON VIOLENCIA', 'ROBO A TRANSEUNTE EN PARQUES Y MERCADOS CON VIOLENCIA',\n",
    "    'ROBO A TRANSEUNTE EN VIA PUBLICA CON VIOLENCIA', 'ROBO A TRANSEUNTE EN VIA PUBLICA SIN VIOLENCIA',\n",
    "    'ROBO A TRANSEUNTE SALIENDO DEL BANCO CON VIOLENCIA', 'ROBO A TRANSEUNTE SALIENDO DEL CAJERO CON VIOLENCIA',\n",
    "    'ROBO A TRANSEUNTE Y VEHICULO CON VIOLENCIA', 'ROBO A TRANSPORTISTA Y VEHICULO PESADO CON VIOLENCIA',\n",
    "    'ROBO A TRANSPORTISTA Y VEHICULO PESADO SIN VIOLENCIA', 'ROBO DE ACCESORIOS DE AUTO',\n",
    "    'ROBO DE MOTOCICLETA CON VIOLENCIA', 'ROBO DE MOTOCICLETA SIN VIOLENCIA',\n",
    "    'ROBO DE OBJETOS DEL INTERIOR DE UN VEHICULO', 'ROBO DE VEHICULO DE PEDALES',\n",
    "    'ROBO DE VEHICULO DE SERVICIO DE TRANSPORTE CON VIOLENCIA', 'ROBO DE VEHICULO DE SERVICIO DE TRANSPORTE SIN VIOLENCIA',\n",
    "    'ROBO DE VEHICULO DE SERVICIO PARTICULAR CON VIOLENCIA', 'ROBO DE VEHICULO DE SERVICIO PARTICULAR SIN VIOLENCIA',\n",
    "    'ROBO DE VEHICULO DE SERVICIO PÚBLICO CON VIOLENCIA', 'ROBO DE VEHICULO DE SERVICIO PÚBLICO SIN VIOLENCIA',\n",
    "    'SECUESTRO EXPRESS (PARA COMETER ROBO O EXTORSIÓN)', 'TALA'\n",
    "]\n",
    "\n",
    "def get_crime_categories() -> list[str]:\n",
    "    \"\"\"\n",
    "    Returns the predefined list of allowed crime categories.\n",
    "    \"\"\"\n",
    "    return CRIME_CATEGORIES\n",
    "\n",
    "def load_crimes(data_dir: Path, target_crimes: list[str]) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Loads all CSV files in a directory and filters by a list of target crimes.\n",
    "    \"\"\"\n",
    "    if not data_dir.exists() or not data_dir.is_dir():\n",
    "        logger.error(f\"Directory not found: {data_dir}\")\n",
    "        raise FileNotFoundError(f\"Directory not found: {data_dir}\")\n",
    "\n",
    "    dataframes = []\n",
    "    logger.info(f\"Scanning directory: {data_dir} for {len(target_crimes)} crime categories.\")\n",
    "    \n",
    "    for file_path in data_dir.glob(\"*.csv\"):\n",
    "        try:\n",
    "            df = pd.read_csv(file_path, low_memory=False)\n",
    "            if 'delito' in df.columns:\n",
    "                filtered_df = df[df['delito'].isin(target_crimes)]\n",
    "                if not filtered_df.empty:\n",
    "                    dataframes.append(filtered_df)\n",
    "            else:\n",
    "                # Usa DEBUG para no saturar la consola, pero queda registrado para auditoría\n",
    "                logger.debug(f\"Column 'delito' missing in {file_path.name}\")\n",
    "        except Exception as e:\n",
    "            logger.warning(f\"Error reading {file_path.name}: {e}\")\n",
    "\n",
    "    if not dataframes:\n",
    "        logger.info(\"No matching records found in any file.\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    result_df = pd.concat(dataframes, ignore_index=True)\n",
    "    logger.info(f\"Successfully loaded {len(result_df)} records.\")\n",
    "    return result_df\n",
    "\n",
    "def load_single_crime(data_dir: Path, allowed_crimes: list[str], target_crime: str) -> pd.DataFrame:\n",
    "    \"\"\"Validates and loads data for a single specific crime.\"\"\"\n",
    "    if target_crime not in allowed_crimes:\n",
    "        logger.error(f\"Invalid crime category requested: '{target_crime}'\")\n",
    "        raise ValueError(f\"Crime '{target_crime}' is not in the allowed list.\")\n",
    "    \n",
    "    logger.info(f\"Initiating load process for single crime: {target_crime}\")\n",
    "    return load_crimes(data_dir, [target_crime])\n",
    "\n",
    "def run_interactive_menu(data_dir: Path) -> tuple[pd.DataFrame, str]:\n",
    "    \"\"\"Handles terminal UI to select and load a specific crime.\"\"\"\n",
    "    allowed_crimes = get_crime_categories()\n",
    "    \n",
    "    print(\"=== AVAILABLE CRIME CATEGORIES ===\")\n",
    "    for idx, crime in enumerate(allowed_crimes, 1):\n",
    "        print(f\"{idx}. {crime}\")\n",
    "        \n",
    "    print(\"-\" * 50)\n",
    "    selected_crime = input(\"\\nEnter the exact name of the crime to load: \").strip()\n",
    "    \n",
    "    try:\n",
    "        print(\"\\n⏳ Processing... check logs for details...\")\n",
    "        df_result = load_single_crime(data_dir, allowed_crimes, selected_crime)\n",
    "        \n",
    "        if df_result.empty:\n",
    "            print(f\"❌ No records found for: {selected_crime}\")\n",
    "        else:\n",
    "            print(f\"\\n✅ Success! Loaded {len(df_result)} records.\")\n",
    "            print(\"The variable containing the DataFrame is now enabled and ready to use.\")\n",
    "            \n",
    "        # Retorna el DataFrame y el string seleccionado\n",
    "        return df_result, selected_crime\n",
    "        \n",
    "    except ValueError as e:\n",
    "        print(f\"\\n❌ Error: {e}\")\n",
    "        sys.exit(1)\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    setup_logging()\n",
    "    \n",
    "    folder_path = \"data/delitos/csv\"\n",
    "    DATA_PATH = Path(folder_path)\n",
    "    \n",
    "    # Desempaquetado directo a variables globales de la sesión\n",
    "    df_raw, target_crime = run_interactive_menu(DATA_PATH)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dcc62996",
   "metadata": {},
   "outputs": [],
   "source": [
    "START_DATE = pd.Timestamp('2016-01-01')\n",
    "END_DATE = pd.Timestamp('2024-06-30')\n",
    "\n",
    "def ensure_datetime_type(df: pd.DataFrame, column: str) -> pd.DataFrame:\n",
    "    \"\"\"Verifica si la columna es datetime; si no lo es, realiza la conversión.\"\"\"\n",
    "    if not pd.api.types.is_datetime64_any_dtype(df[column]):\n",
    "        df[column] = pd.to_datetime(df[column], errors='coerce')\n",
    "    return df\n",
    "\n",
    "def extract_dates(df: pd.DataFrame, date_column: str) -> pd.DataFrame:\n",
    "    \"\"\"Extrae la columna como DataFrame y garantiza que el tipo sea datetime.\"\"\"\n",
    "    df_dates = df[[date_column]].copy()\n",
    "    df_dates = ensure_datetime_type(df_dates, date_column)\n",
    "    return df_dates\n",
    "\n",
    "def filter_by_date_range(df: pd.DataFrame, date_column: str, start: pd.Timestamp, end: pd.Timestamp) -> pd.DataFrame:\n",
    "    \"\"\"Filtra el DataFrame dentro del periodo definido.\"\"\"\n",
    "    mask = (df[date_column] >= start) & (df[date_column] <= end)\n",
    "    return df[mask].copy()\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "\n",
    "# 1. Extracción y conversión a fecha\n",
    "df_dates = extract_dates(df_raw, 'fecha_hecho')\n",
    "\n",
    "# 2. Filtrado por rango temporal\n",
    "df_filtered_range = filter_by_date_range(df_dates, 'fecha_hecho', START_DATE, END_DATE)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 95,
   "id": "5d2a6fd1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import plotly.graph_objects as go\n",
    "\n",
    "def events_by_week(df: pd.DataFrame, date_column: str = 'fecha_hecho', origin_date: pd.Timestamp = START_DATE) -> pd.DataFrame:\n",
    "    \"\"\"Agrupa en bloques de 7 días absolutos (168 horas) anclados a origin_date.\"\"\"\n",
    "    weekly_series = (\n",
    "        df.resample('168h', on=date_column, origin=origin_date)\n",
    "        .size()\n",
    "        .reset_index(name='cantidad')\n",
    "    )\n",
    "    # Estandariza la fecha para asegurar que se muestre como 'YYYY-MM-DD' eliminando las horas (00:00:00)\n",
    "    weekly_series[date_column] = weekly_series[date_column].dt.normalize()\n",
    "    return weekly_series\n",
    "\n",
    "df_weekly = events_by_week(df_filtered_range, 'fecha_hecho', START_DATE)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "23f525ca",
   "metadata": {},
   "outputs": [],
   "source": [
    "def assign_network_nodes(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Asigna un identificador secuencial (nodo) a cada bloque temporal y ordena las columnas.\"\"\"\n",
    "    df_nodes = df.copy()\n",
    "    \n",
    "    # Genera una secuencia ascendente iniciando en 0\n",
    "    df_nodes['nodo'] = range(len(df_nodes))\n",
    "    \n",
    "    # Selecciona y reordena estrictamente las columnas requeridas\n",
    "    return df_nodes[['nodo', 'fecha_hecho', 'cantidad']]\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "serie_semanal = assign_network_nodes(df_weekly)"
   ]
  },
