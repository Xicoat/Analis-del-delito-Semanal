   "source": [
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import powerlaw\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "def graficar_ajuste_ley_potencia(grafo: nx.Graph, crime_name: str):\n",
    "    \"\"\"Calcula y grafica el ajuste de Ley de Potencia (P(k)) para la red de visibilidad.\"\"\"\n",
    "    if getattr(grafo, 'number_of_nodes', lambda: 0)() == 0:\n",
    "        print(\"❌ Error: El grafo está vacío.\")\n",
    "        return\n",
    "\n",
    "    # 1. Preparación de datos (filtrar nodos aislados si los hubiera)\n",
    "    data = np.array([d for _, d in grafo.degree() if d > 0])\n",
    "    if len(data) == 0:\n",
    "        print(\"⚠️ El grafo no tiene nodos con grado mayor a cero.\")\n",
    "        return\n",
    "    \n",
    "    # 2. Ajuste matemático Power Law\n",
    "    fit = powerlaw.Fit(data, discrete=True, verbose=False)\n",
    "    R, p_value_PL = fit.distribution_compare('power_law', 'lognormal', normalized_ratio=True)\n",
    "    res_log = \"Power Law\" if R > 0 else \"Alternativa\"\n",
    "    \n",
    "    sigma_val = fit.power_law.sigma\n",
    "    xmin_val = fit.power_law.xmin\n",
    "    gamma_val = fit.power_law.alpha\n",
    "    nodos_cumplen = np.sum(data >= xmin_val)\n",
    "\n",
    "    # 3. Extracción de fechas para el título\n",
    "    fechas = [pd.to_datetime(d['fecha_hecho']) for _, d in grafo.nodes(data=True) if 'fecha_hecho' in d]\n",
    "    rango_fechas = f\"({min(fechas).strftime('%Y-%m-%d')} – {max(fechas).strftime('%Y-%m-%d')})\" if fechas else \"(Periodo Desconocido)\"\n",
    "\n",
    "    titulo = (\n",
    "        f\"Distribución de Grado P(k) y Ajuste de Ley de Potencia (CSN)\\n\"\n",
    "        f\"Red de Visibilidad Semanal - {crime_name.title()}\\n\"\n",
    "        f\"{rango_fechas}\"\n",
    "    )\n",
    "\n",
    "    # 4. Generación del gráfico\n",
    "    plt.figure(figsize=(7, 5), dpi=100)\n",
    "\n",
    "    # Bandas de Confianza (simulación de varianza de gamma)\n",
    "    x_space = np.linspace(xmin_val, data.max(), 100)\n",
    "    for s in np.linspace(-2, 2, 50):\n",
    "        gamma_var = gamma_val + (s * sigma_val)\n",
    "        y_var = (gamma_var - 1) * (xmin_val**(gamma_var - 1)) * (x_space**-gamma_var)\n",
    "        plt.plot(x_space, y_var, color='royalblue', alpha=0.15, linewidth=0.6, zorder=1)\n",
    "\n",
    "    # Datos empíricos y Ajuste óptimo\n",
    "    fit.plot_pdf(color='black', marker='o', linestyle='None', markersize=5, label='Datos Empíricos')\n",
    "    fit.power_law.plot_pdf(color='red', linestyle='--', linewidth=2, label='Ajuste Óptimo Power Law')\n",
    "\n",
    "    # 5. Cuadro de anotaciones estadísticas\n",
    "    texto_stats = (\n",
    "        f\"$\\\\mathbf{{Métricas\\\\ del\\\\ Ajuste:}}$\\n\"\n",
    "        f\"Gamma ($\\\\gamma$): {gamma_val:.4f}\\n\"\n",
    "        f\"Xmin: {xmin_val:.2f}\\n\"\n",
    "        f\"Nodos (k >= Xmin): {nodos_cumplen} / {len(data)}\\n\\n\"\n",
    "        f\"$\\\\mathbf{{Bondad\\\\ de\\\\ Ajuste:}}$\\n\"\n",
    "        f\"p-value (PL): {p_value_PL:.4f}\\n\\n\"\n",
    "        f\"$\\\\mathbf{{Comparación\\\\ (R):}}$\\n\"\n",
    "        f\"R: {R:.4f} ({res_log})\"\n",
    "    )\n",
    "    \n",
    "    plt.text(0.05, 0.05, texto_stats, transform=plt.gca().transAxes, fontsize=8,\n",
    "             verticalalignment='bottom', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n",
    "\n",
    "    # Formateo estético\n",
    "    plt.title(titulo, fontsize=11, pad=15)\n",
    "    plt.xlabel('Grado (k)', fontsize=10)\n",
    "    plt.ylabel('P(k)', fontsize=10)\n",
    "    plt.xscale('log')\n",
    "    plt.yscale('log')\n",
    "    plt.grid(True, which=\"both\", ls=\"--\", alpha=0.3)\n",
    "    plt.legend(loc='upper right', fontsize=8)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    #plt.show()\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "graficar_ajuste_ley_potencia(visibility_graph, target_crime)"
   ]
