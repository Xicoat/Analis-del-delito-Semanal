   "source": [
    "import networkx as nx\n",
    "import pandas as pd\n",
    "\n",
    "def build_natural_visibility_graph(df: pd.DataFrame) -> nx.Graph:\n",
    "    \"\"\"Construye el Grafo de Visibilidad Natural (NVG) a partir de una serie temporal continua.\"\"\"\n",
    "    g = nx.Graph()\n",
    "    \n",
    "    # 1. Asignar nodos con sus atributos de serie de tiempo\n",
    "    for _, row in df.iterrows():\n",
    "        g.add_node(\n",
    "            int(row['nodo']),\n",
    "            fecha_hecho=row['fecha_hecho'],\n",
    "            cantidad=float(row['cantidad'])\n",
    "        )\n",
    "        \n",
    "    y = df['cantidad'].to_numpy()\n",
    "    n = len(y)\n",
    "    \n",
    "    # 2. Evaluación del criterio geométrico de visibilidad\n",
    "    for i in range(n - 1):\n",
    "        # Nodos temporales inmediatamente contiguos siempre tienen línea de visión\n",
    "        g.add_edge(i, i + 1)\n",
    "        \n",
    "        # Pendiente máxima inicial observada hacia el nodo adyacente\n",
    "        max_slope = y[i + 1] - y[i]\n",
    "        \n",
    "        # Evaluar visibilidad para horizontes j > i + 1\n",
    "        for j in range(i + 2, n):\n",
    "            # Pendiente de la secante entre el punto i y el punto j: (y_j - y_i) / (j - i)\n",
    "            slope = (y[j] - y[i]) / (j - i)\n",
    "            \n",
    "            # Condición de visibilidad: la pendiente debe superar el obstáculo más alto previo\n",
    "            if slope > max_slope:\n",
    "                g.add_edge(i, j)\n",
    "                max_slope = slope\n",
    "                \n",
    "    return g\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "visibility_graph = build_natural_visibility_graph(serie_semanal)\n",
    "\n",
    "# Verificación canónica de la topología resultante\n",
    "print(f\"Total de nodos (|V|): {visibility_graph.number_of_nodes()}\")\n",
    "print(f\"Total de aristas (|E|): {visibility_graph.number_of_edges()}\")"
   ]
  },
