   "source": [
    "import numpy as np\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import random\n",
    "import re\n",
    "\n",
    "def graficar_comparativa_modelos_cercanos(grafo: nx.Graph, crime_name: str):\n",
    "    \"\"\"Encuentra y grafica el modelo teórico más cercano a la red empírica bajo ataques y fallas.\"\"\"\n",
    "    if getattr(grafo, 'number_of_nodes', lambda: 0)() == 0:\n",
    "        print(\"❌ Error: El grafo está vacío.\")\n",
    "        return\n",
    "\n",
    "    # 1. PARÁMETROS BASE Y FECHAS\n",
    "    N = grafo.number_of_nodes()\n",
    "    M = grafo.number_of_edges()\n",
    "    p = (2 * M) / (N * (N - 1)) if N > 1 else 0\n",
    "    sqrt_nodes = int(np.sqrt(N))\n",
    "\n",
    "    fechas = [pd.to_datetime(d['fecha_hecho']) for _, d in grafo.nodes(data=True) if 'fecha_hecho' in d]\n",
    "    rango_fechas = f\"({min(fechas).strftime('%Y-%m-%d')} – {max(fechas).strftime('%Y-%m-%d')})\" if fechas else \"(Periodo Desconocido)\"\n",
    "\n",
    "    # 2. GENERACIÓN DE MODELOS TEÓRICOS\n",
    "    def enlace_igualitario(n, k):\n",
    "        G = nx.Graph()\n",
    "        G.add_nodes_from(range(n))\n",
    "        for i in range(n):\n",
    "            for j in range(i + 1, min(i + k + 1, n)):\n",
    "                G.add_edge(i, j)\n",
    "        return G\n",
    "\n",
    "    modelos = {\n",
    "        f'Erdos Renyi (p={p:.4f})': nx.erdos_renyi_graph(N, p),\n",
    "        'Barabasi Albert (m=2)': nx.barabasi_albert_graph(N, 2) if N > 2 else None,\n",
    "        'Barabasi Albert (m=3)': nx.barabasi_albert_graph(N, 3) if N > 3 else None,\n",
    "        'Barabasi Albert (m=4)': nx.barabasi_albert_graph(N, 4) if N > 4 else None,\n",
    "        f'Watts Strogatz (p={p:.4f})': nx.watts_strogatz_graph(N, 4, p) if N >= 4 else None,\n",
    "        'Random Regular (k=2)': nx.random_regular_graph(2, N) if N > 2 else None,\n",
    "        'Enlace Igualitario (k=2)': enlace_igualitario(N, 2),\n",
    "        'Enlace Igualitario (k=1)': enlace_igualitario(N, 1),\n",
    "        'Star': nx.star_graph(N - 1) if N > 0 else None,\n",
    "        'Grid 2D': nx.grid_2d_graph(sqrt_nodes, sqrt_nodes) if sqrt_nodes > 0 else None,\n",
    "        'Ladder': nx.ladder_graph(N // 2) if N >= 2 else None,\n",
    "        'Hypercube': nx.hypercube_graph(int(np.log2(N))) if (N > 0 and (N & (N - 1)) == 0) else None,\n",
    "        'Complete': nx.complete_graph(N),\n",
    "        'Path': nx.path_graph(N),\n",
    "        'Cycle': nx.cycle_graph(N),\n",
    "        'Circular Ladder': nx.circular_ladder_graph(N // 2) if N >= 2 else None,\n",
    "    }\n",
    "    modelos_validos = {k: v for k, v in modelos.items() if v is not None}\n",
    "\n",
    "    # 3. FUNCIONES DE SIMULACIÓN Y DISTANCIA\n",
    "    def simular_remocion(G_sim, ordenamiento):\n",
    "        G_copy = G_sim.copy()\n",
    "        nodos = ordenamiento(G_copy)\n",
    "        valores = []\n",
    "        for nodo in nodos:\n",
    "            if nodo in G_copy:\n",
    "                G_copy.remove_node(nodo)\n",
    "            valores.append(nx.number_connected_components(G_copy))\n",
    "        return np.array(valores)\n",
    "\n",
    "    def distancia_normalizada(y1, y2):\n",
    "        min_len = min(len(y1), len(y2))\n",
    "        if min_len == 0: return np.nan\n",
    "        y1, y2 = y1[:min_len], y2[:min_len]\n",
    "        max_y1, max_y2 = max(y1) if len(y1) > 0 else 0, max(y2) if len(y2) > 0 else 0\n",
    "        y1_norm = y1 / max_y1 if max_y1 > 0 else y1\n",
    "        y2_norm = y2 / max_y2 if max_y2 > 0 else y2\n",
    "        return np.sqrt(np.sum((y1_norm - y2_norm) ** 2))\n",
    "\n",
    "    estrategias = {\n",
    "        \"Ataque Dirigido (Grado Alto)\": lambda G: sorted(G.nodes(), key=lambda x: G.degree(x), reverse=True),\n",
    "        \"Falla Aleatoria\": lambda G: random.sample(list(G.nodes()), G.number_of_nodes())\n",
    "    }\n",
    "\n",
    "    # 4. PROCESAMIENTO Y BÚSQUEDA DEL MEJOR MODELO\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(16, 7), dpi=100)\n",
    "    resultados_impresion = []\n",
    "\n",
    "    for idx, (nombre_estrategia, func_ordenamiento) in enumerate(estrategias.items()):\n",
    "        # Curva de la red real\n",
    "        curva_base = simular_remocion(grafo, func_ordenamiento)\n",
    "        distancias = []\n",
    "\n",
    "        # Comparar contra todos los modelos teóricos\n",
    "        for nombre_modelo, G_teorico in modelos_validos.items():\n",
    "            curva_teorica = simular_remocion(G_teorico, func_ordenamiento)\n",
    "            d = distancia_normalizada(curva_base, curva_teorica)\n",
    "            distancias.append((nombre_modelo, curva_teorica, d))\n",
    "\n",
    "        # Extraer el modelo con menor distancia\n",
    "        mejor_nombre, mejor_curva, mejor_d = sorted(distancias, key=lambda x: x[2])[0]\n",
    "\n",
    "        # Guardar para la tabla\n",
    "        resultados_impresion.append({\n",
    "            'Estrategia': nombre_estrategia,\n",
    "            'Modelo': mejor_nombre,\n",
    "            'Distancia': mejor_d\n",
    "        })\n",
    "\n",
    "        # Graficar\n",
    "        ax = axes[idx]\n",
    "        ax.plot(curva_base, label=f\"Red Empírica: {crime_name.title()}\", linewidth=3, color=\"blue\", zorder=3)\n",
    "        ax.plot(mejor_curva, label=f\"Modelo más cercano: {mejor_nombre.split('(')[0].strip()}\\n(D={mejor_d:.4f})\",\n",
    "                alpha=0.9, linestyle='--', color=\"red\", linewidth=2, zorder=2)\n",
    "\n",
    "        ax.set_title(f\"{nombre_estrategia}\", fontsize=12, fontweight='bold')\n",
    "        ax.set_xlabel(\"Nodos eliminados (Semanas)\", fontsize=10)\n",
    "        ax.set_ylabel(\"Componentes conectados\", fontsize=10)\n",
    "        ax.legend(fontsize=9, loc='best')\n",
    "        ax.grid(True, linewidth=0.3, linestyle='-', alpha=0.5)\n",
    "\n",
    "    # 5. CONFIGURACIÓN VISUAL Y TÍTULO GLOBAL\n",
    "    plt.suptitle(\n",
    "        f\"Comparativa de Distancia Estructural (Red de Visibilidad Semanal)\\n\"\n",
    "        f\"en {crime_name.title()}\\n\"\n",
    "        f\"{rango_fechas}\",\n",
    "        fontsize=14, y=0.98, fontweight='bold'\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    plt.subplots_adjust(top=0.82)\n",
    "    plt.show()\n",
    "\n",
    "    # 6. IMPRESIÓN EN CONSOLA (EXTRACCIÓN REGEX)\n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(f\"VALORES ESTRUCTURALES Y PARÁMETROS SEMANALES: {crime_name.upper()}\")\n",
    "    print(\"=\"*70)\n",
    "\n",
    "    for res in resultados_impresion:\n",
    "        modelo_nombre = res['Modelo']\n",
    "        k_match = re.search(r'[kK]=(\\d+)', modelo_nombre)\n",
    "        p_match = re.search(r'[pP]=([\\d\\.]+)', modelo_nombre)\n",
    "        \n",
    "        k_val = k_match.group(1) if k_match else \"N/A\"\n",
    "        p_val = p_match.group(1) if p_match else \"N/A\"\n",
    "\n",
    "        print(f\"Estrategia       : {res['Estrategia']}\")\n",
    "        print(f\"Modelo Cercano   : {modelo_nombre}\")\n",
    "        print(f\"Distancia (D)    : {res['Distancia']:.4f}\")\n",
    "        print(f\"Parámetros extra : k = {k_val} | p = {p_val}\")\n",
    "        print(\"-\" * 70)\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "graficar_comparativa_modelos_cercanos(visibility_graph, target_crime)"
   ]
  }
 ],
