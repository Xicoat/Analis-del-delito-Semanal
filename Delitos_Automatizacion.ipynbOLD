   "source": [
    "import pandas as pd\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "def graficar_distribucion_grados(grafo: nx.Graph, crime_name: str):\n",
    "    \"\"\"Genera el gráfico de barras de la distribución de grados de la red de visibilidad.\"\"\"\n",
    "    if grafo.number_of_nodes() == 0:\n",
    "        print(\"❌ Error: El grafo está vacío.\")\n",
    "        return\n",
    "\n",
    "    # 1. Obtener y ordenar los grados de mayor a menor\n",
    "    grados_ordenados = sorted((grado for _, grado in grafo.degree()), reverse=True)\n",
    "\n",
    "    # 2. Extraer rango de fechas para el título\n",
    "    fechas = [pd.to_datetime(data['fecha_hecho']) for _, data in grafo.nodes(data=True) if 'fecha_hecho' in data]\n",
    "    if fechas:\n",
    "        rango_fechas = f\"({min(fechas).strftime('%Y-%m-%d')} – {max(fechas).strftime('%Y-%m-%d')})\"\n",
    "    else:\n",
    "        rango_fechas = \"(Periodo Desconocido)\"\n",
    "\n",
    "    titulo = f\"Distribución de Grados en la Red de Visibilidad Semanal\\n{crime_name.title()}\\n{rango_fechas}\"\n",
    "\n",
    "    # 3. Configuración del lienzo\n",
    "    fig, ax = plt.subplots(figsize=(8, 5.5), dpi=100)\n",
    "    fig.patch.set_facecolor('white')\n",
    "    ax.patch.set_facecolor('white')\n",
    "\n",
    "    # 4. Dibujar las barras\n",
    "    x_pos = np.arange(len(grados_ordenados))\n",
    "    ax.bar(x_pos, grados_ordenados, color='white', edgecolor='black', linewidth=1.2)\n",
    "\n",
    "    # 5. Estilos y etiquetas\n",
    "    ax.set_title(titulo, fontsize=13, pad=15, color='black')\n",
    "    ax.set_ylabel(\"Grado del nodo (Conexiones)\", fontsize=11, color='black')\n",
    "    ax.set_xlabel(\"Nodos (Semanas) ordenados por conectividad\", fontsize=11, color='black')\n",
    "\n",
    "    gmax = max(grados_ordenados) if grados_ordenados else 0\n",
    "    ax.set_ylim(0, gmax + max(1, int(gmax * 0.08)))\n",
    "\n",
    "    # Limpieza estética de bordes\n",
    "    ax.spines['top'].set_visible(False)\n",
    "    ax.spines['right'].set_visible(False)\n",
    "    ax.spines['left'].set_color('black')\n",
    "    ax.spines['bottom'].set_color('black')\n",
    "\n",
    "    ax.tick_params(axis='both', direction='out', colors='black', labelsize=9)\n",
    "    ax.yaxis.grid(True, linestyle='--', alpha=0.3, color='gray')\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "graficar_distribucion_grados(visibility_graph, target_crime)"
   ]
  },
