   "source": [
    "import numpy as np\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import math\n",
    "import random  # <--- Agregado para evitar el error de Numpy con las tuplas\n",
    "\n",
    "def evaluar_resiliencia_topologica(grafo: nx.Graph, crime_name: str):\n",
    "    \"\"\"Evalúa la resiliencia de la red frente a ataques dirigidos y fallas aleatorias, comparándola con modelos teóricos.\"\"\"\n",
    "    if getattr(grafo, 'number_of_nodes', lambda: 0)() == 0:\n",
    "        print(\"❌ Error: El grafo está vacío.\")\n",
    "        return\n",
    "\n",
    "    # 1. PARÁMETROS EMPÍRICOS\n",
    "    N = grafo.number_of_nodes()\n",
    "    M = grafo.number_of_edges()\n",
    "    p = (2 * M) / (N * (N - 1)) if N > 1 else 0\n",
    "    k_avg = sum(dict(grafo.degree()).values()) / N if N > 0 else 0\n",
    "    \n",
    "    # 2. TABLA DE RESUMEN\n",
    "    print(f\"\\n--- Parámetros Estructurales Semanales para {crime_name.title()} ---\")\n",
    "    df_params = pd.DataFrame({\n",
    "        'Métrica': ['Nodos (Semanas)', 'Enlaces (m)', 'Grado Promedio (k)', 'Densidad (p)'],\n",
    "        'Valor': [N, M, f\"{k_avg:.4f}\", f\"{p:.4f}\"]\n",
    "    })\n",
    "    print(df_params.to_string(index=False))\n",
    "    print(\"-\" * 55)\n",
    "\n",
    "    # 3. GENERACIÓN DE MODELOS TEÓRICOS\n",
    "    def enlace_igualitario(n, k):\n",
    "        G = nx.Graph()\n",
    "        G.add_nodes_from(range(n))\n",
    "        for i in range(n):\n",
    "            for j in range(i + 1, min(i + k + 1, n)):\n",
    "                G.add_edge(i, j)\n",
    "        return G\n",
    "\n",
    "    sqrt_nodes = int(np.sqrt(N))\n",
    "    modelos = {\n",
    "        'Red Empírica Semanal': grafo,\n",
    "        f'Erdos Renyi (p={p:.4f})': nx.erdos_renyi_graph(N, p),\n",
    "        'Barabasi Albert (m=2)': nx.barabasi_albert_graph(N, 2) if N > 2 else None,\n",
    "        'Barabasi Albert (m=3)': nx.barabasi_albert_graph(N, 3) if N > 3 else None,\n",
    "        'Barabasi Albert (m=4)': nx.barabasi_albert_graph(N, 4) if N > 4 else None,\n",
    "        f'Watts Strogatz (p={p:.4f})': nx.watts_strogatz_graph(N, 4, p) if N >= 4 else None,\n",
    "        'Random Regular (k=2)': nx.random_regular_graph(2, N) if N > 2 else None,\n",
    "        'Enlace Igualitario 2': enlace_igualitario(N, 2),\n",
    "        'Enlace Igualitario 1': enlace_igualitario(N, 1),\n",
    "        'Star': nx.star_graph(N - 1) if N > 0 else None,\n",
    "        'Grid 2D': nx.grid_2d_graph(sqrt_nodes, sqrt_nodes) if sqrt_nodes > 0 else None,\n",
    "        'Ladder': nx.ladder_graph(N // 2) if N >= 2 else None,\n",
    "        'Hypercube': nx.hypercube_graph(int(np.log2(N))) if (N > 0 and (N & (N - 1)) == 0) else None,\n",
    "        'Complete': nx.complete_graph(N),\n",
    "        'Path': nx.path_graph(N),\n",
    "        'Cycle': nx.cycle_graph(N),\n",
    "        'Circular Ladder': nx.circular_ladder_graph(N // 2) if N >= 2 else None,\n",
    "    }\n",
    "    \n",
    "    # Filtrar modelos nulos (por restricciones matemáticas de tamaño)\n",
    "    modelos_validos = {k: v for k, v in modelos.items() if v is not None}\n",
    "\n",
    "    # 4. EXTRACCIÓN DE FECHAS PARA EL TÍTULO\n",
    "    fechas = [pd.to_datetime(d['fecha_hecho']) for _, d in grafo.nodes(data=True) if 'fecha_hecho' in d]\n",
    "    rango_fechas = f\"({min(fechas).strftime('%Y-%m-%d')} – {max(fechas).strftime('%Y-%m-%d')})\" if fechas else \"(Periodo Desconocido)\"\n",
    "\n",
    "    # 5. MOTOR DE SIMULACIÓN Y RENDERIZADO\n",
    "    # Corrección: Se utiliza random.sample en lugar de np.random.permutation\n",
    "    estrategias = [\n",
    "        (\"Ataque Dirigido (Nodos de Mayor Grado)\", lambda G: sorted(G.nodes(), key=lambda x: G.degree(x), reverse=True)),\n",
    "        (\"Falla Aleatoria (Nodos al Azar)\", lambda G: random.sample(list(G.nodes()), G.number_of_nodes()))\n",
    "    ]\n",
    "\n",
    "    for nombre_estrategia, func_ordenamiento in estrategias:\n",
    "        filas = math.ceil(len(modelos_validos) / 5)\n",
    "        fig, axes = plt.subplots(filas, 5, figsize=(18, 3.5 * filas))\n",
    "        axes = axes.flatten()\n",
    "\n",
    "        for i, (nombre_red, red_teorica) in enumerate(modelos_validos.items()):\n",
    "            G_temp = red_teorica.copy()\n",
    "            nodos_a_remover = func_ordenamiento(G_temp)\n",
    "            \n",
    "            # Simulación de remoción secuencial\n",
    "            componentes = []\n",
    "            for nodo in nodos_a_remover:\n",
    "                G_temp.remove_node(nodo)\n",
    "                componentes.append(nx.number_connected_components(G_temp))\n",
    "                \n",
    "            # Graficado\n",
    "            axes[i].plot(componentes, color='royalblue')\n",
    "            axes[i].set_title(nombre_red, fontsize=9)\n",
    "            axes[i].set_xlabel(\"Nodos removidos\", fontsize=8)\n",
    "            axes[i].set_ylabel(\"Componentes conexos\", fontsize=8)\n",
    "\n",
    "        # Ocultar subplots vacíos\n",
    "        for j in range(i + 1, len(axes)):\n",
    "            axes[j].set_visible(False)\n",
    "\n",
    "        # Formato global\n",
    "        fig.suptitle(f\"{nombre_estrategia}\\nRed de Visibilidad Semanal - {crime_name.title()}\\n{rango_fechas}\",\n",
    "                     fontsize=14, y=1.02, fontweight='bold')\n",
    "        \n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "evaluar_resiliencia_topologica(visibility_graph, target_crime)"
   ]
  },
