    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.lines import Line2D\n",
    "import pandas as pd\n",
    "\n",
    "def plot_network(grafo: nx.Graph, metricas: dict, crime_name: str):\n",
    "    \"\"\"Renderiza la red de visibilidad estática usando Matplotlib con métricas precalculadas.\"\"\"\n",
    "    if grafo.number_of_nodes() == 0:\n",
    "        print(\"❌ Error: El grafo está vacío.\")\n",
    "        return\n",
    "\n",
    "    # 1. Título dinámico numérico (ej. 2016-01-01 - 2016-12-31)\n",
    "    fechas = [pd.to_datetime(data['fecha_hecho']) for _, data in grafo.nodes(data=True) if 'fecha_hecho' in data]\n",
    "    rango_fechas = f\"({min(fechas).strftime('%Y-%m-%d')} – {max(fechas).strftime('%Y-%m-%d')})\"\n",
    "\n",
    "    titulo_grafico = f\"Red de Visibilidad Semanal con Métricas Clave\\n{crime_name.title()}\\n{rango_fechas}\"\n",
    "\n",
    "    # 2. Configurar lienzo y layout original\n",
    "    fig, ax = plt.subplots(figsize=(15, 8))\n",
    "    #pos = nx.spring_layout(grafo, k=0.4, iterations=50, seed=42)\n",
    "    pos = nx.spring_layout(grafo, seed=42)\n",
    "\n",
    "    # 3. Capas de dibujo base\n",
    "    nx.draw_networkx_edges(grafo, pos, edge_color='lightgray', width=1.0, alpha=0.6, ax=ax)\n",
    "    nx.draw_networkx_nodes(grafo, pos, node_color='white', node_size=180, edgecolors='black', linewidths=0.6, ax=ax)\n",
    "\n",
    "    # 4. Capas de dibujo para métricas extremas\n",
    "    if metricas.get('aristas_diametro'):\n",
    "        nx.draw_networkx_edges(grafo, pos, edgelist=metricas['aristas_diametro'], edge_color='red', width=2.5, ax=ax)\n",
    "    if metricas.get('aristas_radio'):\n",
    "        nx.draw_networkx_edges(grafo, pos, edgelist=metricas['aristas_radio'], edge_color='green', width=2.5, ax=ax)\n",
    "    if metricas.get('centro'):\n",
    "        nx.draw_networkx_nodes(grafo, pos, nodelist=metricas['centro'], node_color='yellow', node_size=220, edgecolors='black', ax=ax)\n",
    "    nx.draw_networkx_labels(grafo, pos, font_size=5.5, font_weight='bold', ax=ax)\n",
    "\n",
    "    # 5. Construcción de leyenda estática\n",
    "    elementos_leyenda = [\n",
    "        Line2D([0], [0], color='w', label=f\"Densidad Empírica: {metricas.get('densidad_empirica', 0):.4f}\")\n",
    "    ]\n",
    "    if metricas.get('centro'):\n",
    "        elementos_leyenda.append(Line2D([0], [0], marker='o', color='w', label=f\"Centro: {metricas['centro']}\", markerfacecolor='yellow', markersize=10, markeredgecolor='black'))\n",
    "    if metricas.get('diametro') is not None:\n",
    "        elementos_leyenda.append(Line2D([0], [0], color='red', lw=3, label=f\"Diámetro: {metricas['diametro']}\"))\n",
    "    if metricas.get('radio') is not None:\n",
    "        elementos_leyenda.append(Line2D([0], [0], color='green', lw=3, label=f\"Radio: {metricas['radio']}\"))\n",
    "\n",
    "    ax.legend(handles=elementos_leyenda, loc='best', facecolor='white', framealpha=0.8, fontsize=10)\n",
    "\n",
    "    # Renderizado final\n",
    "    plt.title(titulo_grafico, fontsize=16, pad=15)\n",
    "    plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "plot_network(visibility_graph, metricas, target_crime)"
   ]
  },
