    "import pandas as pd\n",
    "import networkx as nx\n",
    "\n",
    "def imprimir_resumen_metricas(grafo: nx.Graph):\n",
    "    \"\"\"Calcula e imprime un resumen analítico completo de la topología de la red.\"\"\"\n",
    "    if not isinstance(grafo, nx.Graph) or grafo.number_of_nodes() == 0:\n",
    "        print(\"❌ Error: Grafo vacío o inválido.\")\n",
    "        return\n",
    "\n",
    "    print(\"======================================================\")\n",
    "    print(\"   RESUMEN DE MÉTRICAS DE LA RED DE VISIBILIDAD SEMANAL \")\n",
    "    print(\"======================================================\")\n",
    "\n",
    "    # --- Función auxiliar de extracción segura ---\n",
    "    def get_fecha(nodo):\n",
    "        fecha_val = grafo.nodes[nodo].get('fecha_hecho', None)\n",
    "        if pd.notna(fecha_val):\n",
    "            return pd.to_datetime(fecha_val).strftime('%Y-%m-%d')\n",
    "        return \"N/A\"\n",
    "\n",
    "    def get_valor(nodo):\n",
    "        return grafo.nodes[nodo].get('cantidad', 0)\n",
    "\n",
    "    # --- 1. MÉTRICAS GENERALES ---\n",
    "    print(\"\\n--- 1. MÉTRICAS GENERALES DE LA RED ---\")\n",
    "    num_nodos = grafo.number_of_nodes()\n",
    "    num_enlaces = grafo.number_of_edges()\n",
    "    componentes = nx.number_connected_components(grafo)\n",
    "\n",
    "    print(f\"- Número total de Nodos (Semanas): {num_nodos}\")\n",
    "    print(f\"- Número total de Enlaces: {num_enlaces}\")\n",
    "    print(f\"- Componentes Conectados: {componentes}\")\n",
    "\n",
    "    # --- 2. CÁLCULO DE MÉTRICAS GLOBALES DE NODOS ---\n",
    "    grados = dict(grafo.degree())\n",
    "    intermediacion = nx.betweenness_centrality(grafo)\n",
    "    cercania = nx.closeness_centrality(grafo)\n",
    "    agrupamiento = nx.clustering(grafo)\n",
    "\n",
    "    # --- 3. MÉTRICAS DE DISTANCIA ---\n",
    "    print(\"\\n--- 3. MÉTRICAS DE DISTANCIA ---\")\n",
    "    if nx.is_connected(grafo):\n",
    "        diametro = nx.diameter(grafo)\n",
    "        radio = nx.radius(grafo)\n",
    "        centro = nx.center(grafo)\n",
    "        excentricidad = nx.eccentricity(grafo)\n",
    "        \n",
    "        print(f\"- Diámetro de la Red: {diametro}\")\n",
    "        print(f\"- Radio de la Red: {radio}\")\n",
    "        print(f\"- Centro de la Red (Nodos): {centro}\")\n",
    "\n",
    "        excentricidad_ordenada = sorted(excentricidad.items(), key=lambda item: item[1])\n",
    "        print(\"\\n  - TOP 5 Nodos con Menor Excentricidad (más céntricos):\")\n",
    "        for nodo, exc in excentricidad_ordenada[:5]:\n",
    "            print(f\"    - Nodo {nodo} (Semana {get_fecha(nodo)}): Excentricidad = {exc}\")\n",
    "    else:\n",
    "        centro = []\n",
    "        excentricidad = {}\n",
    "        print(\"- El grafo no es conexo, no se pueden calcular Diámetro, Radio, Centro ni Excentricidad.\")\n",
    "\n",
    "    # --- 4. ANÁLISIS DE NODOS CLAVE ---\n",
    "    print(\"\\n--- 4. ANÁLISIS DE NODOS CLAVE ---\")\n",
    "    \n",
    "    # Extraer el nodo con el valor máximo\n",
    "    nodos_con_valor = [(n, get_valor(n)) for n in grafo.nodes()]\n",
    "    if nodos_con_valor:\n",
    "        nodo_pico, valor_maximo = max(nodos_con_valor, key=lambda x: x[1])\n",
    "        \n",
    "        print(f\"\\n  - Nodo Pico (Semana con Valor Máximo):\")\n",
    "        print(f\"    - Nodo {nodo_pico} (Inicio {get_fecha(nodo_pico)}) con {valor_maximo} delitos\")\n",
    "        print(f\"    - Métricas Específicas del Nodo Pico:\")\n",
    "        print(f\"      - Grado (Conexiones): {grados.get(nodo_pico)}\")\n",
    "        \n",
    "        exc_pico = excentricidad.get(nodo_pico, 'N/A (No conexo)')\n",
    "        print(f\"      - Excentricidad: {exc_pico}\")\n",
    "        print(f\"      - Centralidad de Intermediación: {intermediacion.get(nodo_pico, 0):.4f}\")\n",
    "        print(f\"      - Centralidad de Cercanía: {cercania.get(nodo_pico, 0):.4f}\")\n",
    "        print(f\"      - Coeficiente de Agrupamiento: {agrupamiento.get(nodo_pico, 0):.4f}\")\n",
    "\n",
    "    if centro:\n",
    "        print(f\"\\n  - Métricas de los Nodos del Centro Geodésico ({centro}):\")\n",
    "        for c_nodo in centro:\n",
    "            print(f\"    - Análisis del Nodo {c_nodo} (Semana {get_fecha(c_nodo)}):\")\n",
    "            print(f\"      - Grado (Conexiones): {grados.get(c_nodo)}\")\n",
    "            print(f\"      - Centralidad de Intermediación: {intermediacion.get(c_nodo, 0):.4f}\")\n",
    "            print(f\"      - Centralidad de Cercanía: {cercania.get(c_nodo, 0):.4f}\")\n",
    "            print(f\"      - Coeficiente de Agrupamiento: {agrupamiento.get(c_nodo, 0):.4f}\")\n",
    "\n",
    "    # --- 5. TOP 5 NODOS POR MÉTRICA ---\n",
    "    print(\"\\n--- 5. TOP 5 NODOS POR MÉTRICA ---\")\n",
    "\n",
    "    print(\"\\n  - TOP 5 Nodos con Mayor Grado (más conectados):\")\n",
    "    for nodo, grado in sorted(grados.items(), key=lambda x: x[1], reverse=True)[:5]:\n",
    "        print(f\"    - Nodo {nodo} ({get_fecha(nodo)}): {grado} conexiones\")\n",
    "\n",
    "    print(\"\\n  - TOP 5 Nodos con Mayor Centralidad de Intermediación (puentes):\")\n",
    "    for nodo, cent in sorted(intermediacion.items(), key=lambda x: x[1], reverse=True)[:5]:\n",
    "        print(f\"    - Nodo {nodo} ({get_fecha(nodo)}): {cent:.4f}\")\n",
    "\n",
    "    print(\"\\n  - TOP 5 Nodos con Mayor Centralidad de Cercanía (mejor acceso):\")\n",
    "    for nodo, cent in sorted(cercania.items(), key=lambda x: x[1], reverse=True)[:5]:\n",
    "        print(f\"    - Nodo {nodo} ({get_fecha(nodo)}): {cent:.4f}\")\n",
    "\n",
    "    # --- 6. COEFICIENTE DE AGRUPAMIENTO (CLUSTERING) ---\n",
    "    print(\"\\n--- 6. COEFICIENTE DE AGRUPAMIENTO (CLUSTERING) ---\")\n",
    "    \n",
    "    agrup_ordenado = sorted(agrupamiento.items(), key=lambda x: x[1], reverse=True)\n",
    "\n",
    "    print(\"\\n  - Nodos con Mayor Coeficiente (en grupos más densos):\")\n",
    "    for nodo, coef in agrup_ordenado[:5]:\n",
    "        print(f\"    - Nodo {nodo} ({get_fecha(nodo)}): {coef:.4f}\")\n",
    "\n",
    "    print(\"\\n  - Nodos con Menor Coeficiente (>0):\")\n",
    "    nodos_menor = [item for item in reversed(agrup_ordenado) if item[1] > 0][:5]\n",
    "    if not nodos_menor: # Fallback si todos son 0\n",
    "        nodos_menor = list(reversed(agrup_ordenado))[:5]\n",
    "        \n",
    "    for nodo, coef in nodos_menor:\n",
    "        print(f\"    - Nodo {nodo} ({get_fecha(nodo)}): {coef:.4f}\")\n",
    "\n",
    "    print(\"\\n======================================================\")\n",
    "    print(\"     Análisis de Métricas Semanales Finalizado         \")\n",
    "    print(\"======================================================\")\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "imprimir_resumen_metricas(visibility_graph)"
   ]
  },
