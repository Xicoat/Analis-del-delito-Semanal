    "import networkx as nx\n",
    "import pandas as pd\n",
    "\n",
    "def graph_to_dataframe(G: nx.Graph) -> pd.DataFrame:\n",
    "    \"\"\"Extrae las métricas y atributos de los nodos de un grafo hacia un DataFrame tabular.\"\"\"\n",
    "    degrees = dict(G.degree())\n",
    "\n",
    "    records = []\n",
    "    for node_id, data in sorted(G.nodes(data=True)):\n",
    "        fecha = pd.Timestamp(data['fecha_hecho'])\n",
    "        records.append({\n",
    "            'nodo': node_id,\n",
    "            'fecha_hecho': fecha,\n",
    "            'semana': node_id,\n",
    "            'año': fecha.year,\n",
    "            'cantidad': data['cantidad'],\n",
    "            'grado': degrees[node_id]\n",
    "        })\n",
    "\n",
    "    return pd.DataFrame(records)\n",
    "\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "df_visibility = graph_to_dataframe(visibility_graph)\n",
    "df_visibility.head()"
   ]
  },
