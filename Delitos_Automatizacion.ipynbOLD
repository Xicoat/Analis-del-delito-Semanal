   ],
   "source": [
    "import pandas as pd\n",
    "import plotly.graph_objects as go\n",
    "\n",
    "def plot_weekly_network_nodes(df: pd.DataFrame, crime_name: str) -> go.Figure:\n",
    "    \"\"\"Renderiza el histograma semanal y la asignación de nodos usando Plotly.\"\"\"\n",
    "    if df.empty:\n",
    "        return go.Figure()\n",
    "\n",
    "    max_val = df['cantidad'].max()\n",
    "    offset = max_val * 0.05 if max_val > 0 else 1\n",
    "\n",
    "    fig = go.Figure()\n",
    "\n",
    "    # 1. Barras de delitos por semana\n",
    "    fig.add_trace(go.Bar(\n",
    "        x=df['fecha_hecho'],\n",
    "        y=df['cantidad'],\n",
    "        marker=dict(color='white', line=dict(color='black', width=1)),\n",
    "        name='Delitos'\n",
    "    ))\n",
    "\n",
    "    # 2. Marcadores de nodos sobre cada barra\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=df['fecha_hecho'],\n",
    "        y=df['cantidad'] + offset,\n",
    "        mode='markers+text',\n",
    "        marker=dict(symbol='circle', color='white', size=14, line=dict(color='black', width=1)),\n",
    "        text=df['nodo'].astype(str),\n",
    "        textfont=dict(color='black', size=8),\n",
    "        textposition='middle center',\n",
    "        name='Nodos'\n",
    "    ))\n",
    "\n",
    "    # Formateo semántico del delito y fechas extremas\n",
    "    formatted_crime = str(crime_name).title()\n",
    "    min_date = df['fecha_hecho'].min()\n",
    "    max_date = df['fecha_hecho'].max()\n",
    "    \n",
    "    title_str = (\n",
    "        f\"Asignación de Nodos en la Serie Temporal Semanal de<br><b>{formatted_crime}</b><br>\"\n",
    "        f\"<sub>Periodo: {min_date.strftime('%Y-%m-%d')} a {max_date.strftime('%Y-%m-%d')}</sub>\"\n",
    "    )\n",
    "\n",
    "    # Selección de etiquetas visibles para el eje X (cada 16 semanas)\n",
    "    visible_ticks = df['fecha_hecho'].iloc[::16]\n",
    "\n",
    "    fig.update_layout(\n",
    "        title=dict(text=title_str, x=0.5, xanchor='center', font=dict(size=16, color='black')),\n",
    "        width=1300,\n",
    "        height=750,\n",
    "        plot_bgcolor='white',\n",
    "        paper_bgcolor='white',\n",
    "        bargap=0.1,\n",
    "        margin=dict(l=70, r=50, t=110, b=100),\n",
    "        showlegend=False,\n",
    "        xaxis=dict(\n",
    "            title='Inicio de Semana (Bloques de 168h)',\n",
    "            color='black',\n",
    "            showline=True,\n",
    "            linecolor='black',\n",
    "            linewidth=1.5,\n",
    "            tickangle=45,\n",
    "            tickmode='array',\n",
    "            tickvals=visible_ticks,\n",
    "            tickformat='%Y-%m-%d'\n",
    "        ),\n",
    "        yaxis=dict(\n",
    "            title='Cantidad de delitos',\n",
    "            color='black',\n",
    "            showline=True,\n",
    "            linecolor='black',\n",
    "            linewidth=1.5,\n",
    "            showgrid=True,\n",
    "            gridcolor='lightgrey',\n",
    "            gridwidth=0.2,\n",
    "            griddash='dash',\n",
    "            range=[0, max_val + (offset * 3)]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    fig.show()\n",
    "    #return fig\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "plot_weekly_network_nodes(serie_semanal, target_crime)"
   ]
  },
