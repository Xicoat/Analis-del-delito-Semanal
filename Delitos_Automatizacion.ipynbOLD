   "source": [
    "import warnings\n",
    "from scipy.optimize import OptimizeWarning\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import powerlaw\n",
    "\n",
    "# Suprimir advertencias internas de optimización de la librería powerlaw\n",
    "warnings.simplefilter(\"ignore\", OptimizeWarning)\n",
    "\n",
    "def graficar_comparacion_modelos(grafo: nx.Graph, crime_name: str):\n",
    "    \"\"\"Genera la comparativa multimodelo y calcula distancias euclidianas para la red.\"\"\"\n",
    "    if getattr(grafo, 'number_of_nodes', lambda: 0)() == 0:\n",
    "        print(\"❌ Error: El grafo está vacío.\")\n",
    "        return\n",
    "\n",
    "    # 1. Preparación de datos\n",
    "    data = np.array([d for _, d in grafo.degree() if d > 0])\n",
    "    if len(data) == 0:\n",
    "        print(\"⚠️ El grafo no tiene nodos con grado mayor a cero.\")\n",
    "        return\n",
    "\n",
    "    print(\"Calculando ajustes teóricos y distancias euclidianas...\")\n",
    "\n",
    "    # 2. Ajuste Multimodelo (Se desactiva el verbose para consola limpia)\n",
    "    fit = powerlaw.Fit(data, discrete=True, verbose=False)\n",
    "    xmin_val = fit.xmin\n",
    "\n",
    "    # 3. Filtrar datos empíricos relevantes (k >= xmin)\n",
    "    data_xmin = data[data >= xmin_val]\n",
    "    if len(data_xmin) == 0:\n",
    "        print(\"⚠️ No hay suficientes datos por encima de xmin.\")\n",
    "        return\n",
    "\n",
    "    # Grados únicos y probabilidad empírica real\n",
    "    k_eval, counts = np.unique(data_xmin, return_counts=True)\n",
    "    y_emp_eval = counts / len(data_xmin)\n",
    "\n",
    "    # 4. Evaluación de las PDF teóricas\n",
    "    y_pl = fit.power_law.pdf(k_eval)\n",
    "    y_lognorm = fit.lognormal.pdf(k_eval)\n",
    "    y_exp = fit.exponential.pdf(k_eval)\n",
    "\n",
    "    # 5. Cálculo de Distancia Euclidiana Vectorizada\n",
    "    dist_pl = np.linalg.norm(y_emp_eval - y_pl)\n",
    "    dist_lognorm = np.linalg.norm(y_emp_eval - y_lognorm)\n",
    "    dist_exp = np.linalg.norm(y_emp_eval - y_exp)\n",
    "\n",
    "    # Mostrar tabla resumen en consola\n",
    "    df_distancias = pd.DataFrame({\n",
    "        'Modelo': ['Ley de Potencia', 'Log-Normal', 'Exponencial'],\n",
    "        'Distancia Euclidiana': [dist_pl, dist_lognorm, dist_exp]\n",
    "    }).sort_values(by='Distancia Euclidiana').reset_index(drop=True)\n",
    "\n",
    "    print(\"\\n\" + \"=\"*50)\n",
    "    print(\"   DISTANCIA EUCLIDIANA RESPECTO A DATOS EMPÍRICOS\")\n",
    "    print(\"=\"*50)\n",
    "    print(df_distancias.to_string(index=False))\n",
    "    print(\"=\"*50)\n",
    "\n",
    "    # 6. Extracción de fechas para el título\n",
    "    fechas = [pd.to_datetime(d['fecha_hecho']) for _, d in grafo.nodes(data=True) if 'fecha_hecho' in d]\n",
    "    rango_fechas = f\"({min(fechas).strftime('%Y-%m-%d')} – {max(fechas).strftime('%Y-%m-%d')})\" if fechas else \"(Periodo Desconocido)\"\n",
    "    \n",
    "    titulo = (\n",
    "        f\"Comparación de Modelos Teóricos y Distancia Euclidiana\\n\"\n",
    "        f\"Red de Visibilidad Semanal - {crime_name.title()}\\n\"\n",
    "        f\"{rango_fechas}\"\n",
    "    )\n",
    "\n",
    "    # 7. Gráfico Comparativo\n",
    "    plt.figure(figsize=(8, 6), dpi=100)\n",
    "\n",
    "    # Datos empíricos\n",
    "    plt.plot(k_eval, y_emp_eval, 'ko', label=r'Datos Empíricos ($k \\geq x_{min}$)', markersize=5)\n",
    "\n",
    "    # Curvas de ajuste\n",
    "    plt.plot(k_eval, y_pl, 'r--', linewidth=2, label=f'Power Law (D = {dist_pl:.5f})')\n",
    "    plt.plot(k_eval, y_lognorm, 'b-.', linewidth=2, label=f'Log-Normal (D = {dist_lognorm:.5f})')\n",
    "    plt.plot(k_eval, y_exp, 'g:', linewidth=2, label=f'Exponencial (D = {dist_exp:.5f})')\n",
    "\n",
    "    # Estilos y visualización\n",
    "    plt.xscale('log')\n",
    "    plt.yscale('log')\n",
    "    plt.xlabel('Grado (k)', fontsize=10)\n",
    "    plt.ylabel('P(k)', fontsize=10)\n",
    "    plt.title(titulo, fontsize=11, pad=12)\n",
    "    plt.grid(True, which=\"both\", ls=\"--\", alpha=0.3)\n",
    "    plt.legend(loc='lower left', fontsize=9)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    #plt.show()\n",
    "\n",
    "# ======================================================================================\n",
    "# EJECUCIÓN\n",
    "# ======================================================================================\n",
    "graficar_comparacion_modelos(visibility_graph, target_crime)"
   ]
  },
